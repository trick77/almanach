# Secrets / per-deployment config
.env
team-keys.json

# Build. Anchored: a bare name matches any path component at any depth.
/backend/almanach
/bin/

# The prompt eval's pages
/.prompt-eval/

# IDEs
.vscode/
.idea/
*.swp
*~

# Agent tooling
.claude/
.agents/
.cursor/
.aider*
.codex/
.zed/
.windsurf/

# macOS
.DS_Store

# ship:begin (owned by ship init; the repo's own lines go above the begin marker)
# What the gate and the UI build write into the tree.
coverage/ui/
ui/node_modules/
ui/*.tsbuildinfo
# The UI build the Go binary embeds; .gitkeep stays tracked so go:embed's dir exists in a fresh clone.
backend/web/dist/*
!backend/web/dist/.gitkeep
# ship:end
