# Stand-ins for compose.yaml's checks, for the dev stack only (make dev).
# Read for interpolation alone, after .env, so these win; compose.dev.yaml
# blanks the OIDC variables in the container, so none of them reaches
# serve. Never real values, never used for production.
PUBLIC_FQDN=localhost
BACKEND_OIDC_ISSUER=https://auth.example.com
BACKEND_OIDC_CLIENT_ID=almanach-dev
BACKEND_OIDC_CLIENT_SECRET=dev-stand-in
BACKEND_OIDC_REDIRECT_URL=https://localhost/api/auth/callback
BACKEND_SESSION_SECRET=dev-stand-in
