# Convention: a live line is required; a commented line is optional and shows
# its default.

# --- Required ---
# The host's view, for the binary run outside compose; compose.yaml gives
# its containers the in-network address itself.
DATABASE_URL=postgresql://almanach:changeme@localhost:5433/almanach
# One bearer per team, JSON {"<team>": "<token>"}; hot-reloaded on change.
# The token is the team's identity: noergler sends it, the team's notes are
# filed under the name here. Never committed.
ALMANACH_TEAM_KEYS_PATH=./team-keys.json
# LiteLLM gateway, the llmwire way: host (https, or http on loopback only,
# which from inside compose is the container itself), key, and which
# profiles the gateway serves under which alias (<profile>=<alias>,...).
# The gateway is not called at startup: a wrong key or alias shows at the
# first fold, and every note folded under it is taken off the queue
# unfolded, for good. Check the log after the first merge.
LLMWIRE_LITELLM_BASE_URL=https://litellm.example.com/v1
LLMWIRE_LITELLM_API_KEY=
LLMWIRE_LITELLM_MODELS=gpt-5.5=ai-gateway-gpt-5.5
# The merge model: an llmwire profile id listed above, never an alias.
ALMANACH_MODEL=gpt-5.5

# --- Optional ---
# ALMANACH_REASONING_EFFORT=            # unset: the model's balanced level
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080
# none: the read API trusts nobody and names nobody. proxy: an OAuth sidecar
# in front sets X-Forwarded-User, and serve refuses any SERVER_HOST but
# 127.0.0.1 so that header can only come from the sidecar.
# ALMANACH_AUTH_MODE=none
# The caps the merge call is held to; over any of them the rewrite is
# rejected whole and the page stays as it was.
# ALMANACH_REPO_MAX_STATEMENTS=40
# ALMANACH_PROJECT_MAX_STATEMENTS=24
# ALMANACH_SUMMARY_MAX_CHARS=1500
# ALMANACH_STATEMENT_MAX_CHARS=300
# How far back the problem areas look.
# ALMANACH_PROBLEM_WINDOW_DAYS=90
# LOG_LEVEL=INFO
# ALMANACH_ENV=dev
