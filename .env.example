# Convention: a live line is required; a commented line is optional and shows
# its default.

# --- Required ---
# The SQLite database file. Its folder must exist and be writable (the
# file's -wal and -shm land beside it), on a local disk, never a shared
# filesystem. The host's view, for the binary run outside compose
# (mkdir data first); compose gives its containers /data/almanach.db
# on the data volume itself.
ALMANACH_DB_PATH=./data/almanach.db
# One bearer per team, JSON {"<team>": "<token>"}; hot-reloaded on change.
# The token is the team's identity: noergler sends it, the team's notes are
# filed under the name here. Never committed. The host's view; compose
# mounts ./conf and gives its container /conf/team-keys.json.
ALMANACH_TEAM_KEYS_PATH=./conf/team-keys.json
# LiteLLM gateway, the llmwire way: host (https, or http on loopback only,
# which from inside compose is the container itself), key, and which
# profiles the gateway serves under which alias (<profile>=<alias>,...).
# Startup lists the gateway's models: a refused key, a 4xx or an alias it
# does not list aborts; a gateway that does not answer is a warning. A
# gateway failure at fold time holds the worker (30s doubling to 10min)
# and the note is tried again after; a note is given up after eight such
# failures.
LLMWIRE_LITELLM_BASE_URL=https://litellm.example.com/v1
LLMWIRE_LITELLM_API_KEY=
LLMWIRE_LITELLM_MODELS=gpt-5.5=ai-gateway-gpt-5.5
# The merge model: an llmwire profile id listed above, never an alias.
ALMANACH_MODEL=gpt-5.5

# --- Required by compose.yaml (production) ---
# compose.yaml runs oidc, fixed: readers sign in at an OpenID provider. It
# checks all six lines below before it starts anything; blank fails, so
# `up` stops until each holds a real value. The dev stack (make dev) needs
# none of them: compose.dev.env stands in. A binary run outside compose
# leaves them blank under none (blank counts as unset) or sets all five
# OIDC lines with ALMANACH_AUTH_MODE=oidc.
# The hostname Traefik routes Almanach on, e.g. almanach.example.com.
PUBLIC_FQDN=
# Exactly as the provider states it, path and trailing slash included,
# e.g. https://auth.example.com
ALMANACH_OIDC_ISSUER=
# The client registered for Almanach at the provider, e.g. almanach.
ALMANACH_OIDC_CLIENT_ID=
ALMANACH_OIDC_CLIENT_SECRET=
# https, this path exactly: https://<PUBLIC_FQDN>/api/auth/callback
ALMANACH_OIDC_REDIRECT_URL=
# openssl rand -base64 48, at least 32 bytes. Rotating it signs everyone out.
ALMANACH_SESSION_SECRET=

# --- Optional ---
# ALMANACH_REASONING_EFFORT=            # unset: the model's balanced level
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080
# none: no sign-in, the read API trusts nobody and names nobody. oidc:
# readers sign in at an OpenID provider; the OIDC lines above are then
# required, and each set one is refused under none. compose.yaml fixes
# oidc, compose.dev.yaml none; this line is for a binary run outside
# compose.
# ALMANACH_AUTH_MODE=none
# The ceilings the merge call is held to: statements per description and
# runes of prose per whole description (the summary plus every statement's
# name and text; file paths do not count). No cap on a
# single statement: a description is documentation. Over a ceiling the
# rewrite is rejected whole and the page stays as it was.
# ALMANACH_REPO_MAX_STATEMENTS=40
# ALMANACH_PROJECT_MAX_STATEMENTS=24
# ALMANACH_REPO_MAX_CHARS=60000
# ALMANACH_PROJECT_MAX_CHARS=40000
# Statement diagrams: nodes and edges per diagram (at most 16 and 24, the
# system map's own limits), diagrams per page (0: none offered).
# ALMANACH_DIAGRAM_MAX_NODES=12
# ALMANACH_DIAGRAM_MAX_EDGES=20
# ALMANACH_MAX_DIAGRAMS=6
# How far back the problem areas look.
# ALMANACH_PROBLEM_WINDOW_DAYS=90
# The clones (the Quellen pages). Unset: the feature is off, no poller, the
# routes answer 404 and the UI hides the entry. Set: the base folder every
# clone lands under as <dir>/<project>/<slug>; must exist and be writable,
# and git must be on PATH. compose gives its container /app/repos on a
# volume itself; this is the host's view for a binary run outside compose.
# ALMANACH_REPOS_DIR=./repos
# base64 of 32 random bytes (openssl rand -base64 32). Seals the sources'
# tokens in the database; unset, public repositories still clone but no
# token can be stored. Changing it orphans every stored token.
# ALMANACH_SECRET_KEY=
# The sync cycle: every source listed, every clone fetched. 0 = on demand
# only (the Synchronisieren buttons).
# ALMANACH_SYNC_INTERVAL=30m
# A PEM bundle for a forge behind an internal CA, handed to git. A path as
# the process sees it: under compose the file sits in ./conf and this reads
# /conf/ca.pem, the container's view.
# ALMANACH_GIT_CA_FILE=
# The baseline: a run reads a clone and writes its description. The
# catalogue step picks what to read; a cheaper llmwire profile may do it,
# unset is ALMANACH_MODEL. Calls and file bytes one run may spend, at least
# 3 calls. A repository whose head moved is read again this long after its
# last run, 0 = only the buttons.
# ALMANACH_CATALOGUE_MODEL=
# ALMANACH_BASELINE_MAX_CALLS=16
# ALMANACH_BASELINE_MAX_BYTES=2000000
# ALMANACH_BASELINE_RECONCILE=720h
# LOG_LEVEL=INFO
# ALMANACH_ENV=dev
